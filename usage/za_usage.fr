Programme principal :
-M main
--help                 | -u : affichage de l'usage                                        
--version              | -V : affichage de la version                                     
--verbose              | -v : augmentation de la verbosite                                
--no-log               | -x : pas de generation de logs                                   
--lang                 | -_ : langue                                                      
--config               | -C : configuration                                               
--list-conf            | -c : affichage des configurations                                
--list-groups          | -G : affichage des groupes definis                               
--list-group           | -g : affichage des serveurs d'un groupe                          
--db-host              | -h : serveur hebergeant la base de donnees                       
--db-name              | -n : nom de la base de donnees                                   
--db-list              | -d : affichage de tables de la base de donnees                   
      --collects             | -C : affichage de la liste des collectes                         
      --TS                   | -T : liste des timestamps                                        
      --servers              | -S : liste des serveurs                                          
      --users                | -U : liste des utilisateurs                                      
      --pathnames            | -P : liste des pathnames                                         
      --RPM                  | -R : liste des RPM                                               
      --dpkg                 | -D : liste des paquets Debian                                    
      --sccs                 | -s : liste des archives SCCS                                     
--log-config           | -l : configuration des logs                                      
      --hires-ts             | -T : affichage des temps haute resolution                        
      --ts                   | -t : affichage des temps                                         
      --delta-t              | -d : affichage des durees (delta T)                              
      --duration             | -D : affichage des durees                                        
      --where                | -w : affichage de l'origine d'un message                         
      --origin-full          | -f : affichage du pathname complet du programme                  
      --origin-base          | -b : affichage du nom reduit du programme                        
      --pid                  | -p : affichage du PID                                            
      --tid                  | -H : affichage du TID (Thread ID)                                
      --no-tty-err           | -E : redirection de stderr vers le fichier de log                
--debug-mode           | -D : activation du mode de debug                                 
      --debug                | -d : debug                                                       
      --protocol             | -P : affichage du protocole                                      
      --k-fct                | -f : K: trace des fonctions                                      
      --k-ctx                | -c : K: trace des contextes                                      
      --k-read               | -r : K: trace des lectures                                       
      --k-write              | -w : K: trace des ecritures                                      
      --k-tl                 | -t : K: trace des types/longueurs                                
      --k-v                  | -v : K: trace des valeurs                                        
      --k-dump               | -D : K: trace dump                                               
      --mutex                | -m : trace des operations sur les mutex                          
      --sql-req              | -S : affichage des requetes SQL                                  
      --disp-insert          | -i : affichage des insertions d'elements                         
      --options              | -O : trace du decodage des options                               
      --opts-infos           | -I : affichage des options correspondant aux infos               
      --opts-all             | -A : affichage de toutes les options                             
      --opts-todo            | -T : affichage des options non implementees                      
      --begin-end            | -b : affichage des entrées et sorties de fonctions              
      --watch-mem            | -W : affichage periodique des informations memoire               
      --mem                  | -M : affichage des informations memoire                          
      --show-free            | -F : visualisation des liberations memoire                       
      --no-free              | -N : pas de liberation memoire                                   
      --intl-chk             | -C : controle de coherence interne                               
      --info                 | -j : informations                                                
      --sizes                | -s : affichage de tailles d'elements                             
      --links                | -l : generation de marqueurs pour le chainage des pages (tests)  
--lex                  | -L : trace des analyseurs lexicaux                               
      --AT                   | -s : gestion des noms de sources                                 
      --AJ                   | -S : gestion des groupes de serveurs                             
      --BL                   | -C : gestion du fichier de configuration                         
      --AP                   | -c : gestion des couleurs                                        
